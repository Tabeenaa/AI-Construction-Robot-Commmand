    <position name="actuator_2" joint="joint_2" kp="200" kv="20" ctrllimited="true" ctrlrange="-2.5 2.5"/>
    <position name="actuator_3" joint="joint_3" kp="150" kv="15" ctrllimited="true" ctrlrange="-3.14 3.14"/>
