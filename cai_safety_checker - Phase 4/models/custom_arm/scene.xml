    <material name="arm_orange" rgba="0.92 0.45 0.08 1" specular="0.6" shininess="0.5"/>
    <material name="arm_dark" rgba="0.18 0.20 0.24 1" specular="0.4" shininess="0.2"/>
    <material name="wrist_mat" rgba="0.85 0.88 0.92 1" specular="0.7" shininess="0.6"/>
    <material name="gripper_mat" rgba="0.95 0.55 0.1 1" specular="0.5" shininess="0.4"/>

    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link_1" file="link_1.STL"/>
    <mesh name="link_2" file="link_2.STL"/>
    <mesh name="link_3" file="link_3.STL"/>
    <mesh name="link_4" file="link_4.STL"/>
    <mesh name="link_5" file="link_5.STL"/>
    <mesh name="link_6" file="link_6.STL"/>
    <mesh name="link_7" file="link_7.STL"/>
