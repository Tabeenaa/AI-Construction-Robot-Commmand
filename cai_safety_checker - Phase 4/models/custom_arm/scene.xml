    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" pos="0.735 -1.6609 0.90"/>

    <body name="human_marker" pos="0 0 -10" mocap="true">
      <geom name="human_sphere" type="sphere" size="0.15" rgba="1 0 0 0.6" contype="0" conaffinity="0"/>
    </body>

    <!-- Robot Model -->
    <geom type="mesh" material="base_mat" mesh="base_link"/>
    <body name="link_1" pos="0.735 -1.6609 0.92692" quat="0.476268 0.47627 0.522655 0.522653">
      <inertial pos="-0.0352534 0.0544764 0.0001659" quat="0.27494 0.653368 -0.274684 0.649667" mass="0.5" diaginertia="0.001 0.001 0.0005"/>
